{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergePatch",
    ":automergeMinor",
    ":automergePr",
    ":automergeRequireAllStatusChecks",
    ":combinePatchMinorReleases",
    ":dependencyDashboard",
    ":separateMultipleMajorReleases",
    ":configMigration",
    "helpers:pinGitHubActionDigests",
    "group:rust-futuresMonorepo",
    "group:opentelemetry-rustMonorepo",
    "group:opentelemetry-rust-contribMonorepo",
    "schedule:earlyMondays"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "autoApprove": true,
  "automergeStrategy": "squash",
  "rebaseWhen": "conflicted",
  "cloneSubmodules": true,
  "platformAutomerge": true,
  "postUpdateOptions": [
    "pnpmDedupe"
  ],
  "packageRules": [
    {
      "groupName": "{{manager}} non-major dependencies",
      "groupSlug": "{{manager}}-minor-patch",
      "matchPackagePatterns": [
        "*"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "groupName": "Arrow/Parquet",
      "matchSourceUrls": [
        "https://github.com/apache/arrow-rs"
      ]
    },
    {
      "groupName": "DataFusion",
      "matchSourceUrls": [
        "https://github.com/apache/datafusion"
      ]

    },
    {
      "groupName": "flatbuffers",
      "matchSourceUrls": [
        "https://github.com/google/flatbuffers"
      ]
    },
    {
      "groupName": "tonic",
      "matchSourceUrls": [
        "https://github.com/hyperium/tonic"
      ]
    },
    {
      "groupName": "vortex",
      "matchSourceUrls": [
        "https://github.com/vortex-data/vortex"
      ]
    },
    {
      "groupName": "iceberg",
      "matchPackageNames": [
        "iceberg*"
      ]
    },
    {
      "groupName": "pyo3",
      "matchSourceUrls": [
        "https://github.com/PyO3/pyo3"
      ]
    }
  ]
}
