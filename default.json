{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeMinor",
    ":automergePr",
    ":automergeRequireAllStatusChecks",
    ":combinePatchMinorReleases",
    ":dependencyDashboard",
    ":separateMultipleMajorReleases",
    ":configMigration",
    "group:rust-futuresMonorepo",
    "group:opentelemetry-rustMonorepo",
    "group:opentelemetry-rust-contribMonorepo"
  ],
  "schedule": ["* 0-4 * * *"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-4 * * 1"]
  },
  "autoApprove": true,
  "automergeStrategy": "squash",
  "rebaseWhen": "conflicted",
  "cloneSubmodules": true,
  "platformAutomerge": true,
  "postUpdateOptions": [
    "pnpmDedupe"
  ],
  "packageRules": [
    {
      "matchDepTypes": [
        "action"
      ],
      "pinDigests": true,
      "extends": [
        "schedule:weekly"
      ]
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "groupName": "Rust dependencies",
      "branchPrefix": "renovate/cargo/"
    },
    {
      "matchManagers": [
        "uv"
      ],
      "matchFiles": [
        "**/pyproject.toml",
        "**/uv.lock"
      ],
      "groupName": "Python dependencies",
      "branchPrefix": "renovate/uv/"
    },
    {
      "groupName": "Arrow/Parquet",
      "matchSourceUrls": [
        "https://github.com/apache/arrow-rs"
      ]
    },
    {
      "groupName": "DataFusion",
      "matchSourceUrls": [
        "https://github.com/apache/datafusion"
      ]

    },
    {
      "groupName": "flatbuffers",
      "matchSourceUrls": [
        "https://github.com/google/flatbuffers"
      ]
    },
    {
      "groupName": "tonic",
      "matchSourceUrls": [
        "https://github.com/hyperium/tonic"
      ]
    },
    {
      "groupName": "vortex",
      "matchSourceUrls": [
        "https://github.com/vortex-data/vortex"
      ]
    },
    {
      "groupName": "iceberg",
      "matchPackageNames": [
        "iceberg*"
      ]
    },
    {
      "groupName": "pyo3",
      "matchSourceUrls": [
        "https://github.com/PyO3/pyo3"
      ]
    }
  ]
}
