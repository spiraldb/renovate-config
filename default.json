{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeMinor",
    ":automergePr",
    ":automergeRequireAllStatusChecks",
    ":combinePatchMinorReleases",
    ":dependencyDashboard",
    ":separateMultipleMajorReleases",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": ["* 0-4 * * *"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-4 * * 1"]
  },
  "autoApprove": true,
  "automergeStrategy": "squash",
  "rebaseWhen": "conflicted",
  "cloneSubmodules": true,
  "platformAutomerge": true,
  "postUpdateOptions": [
    "pnpmDedupe"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "cargo"
      ],
      "groupName": "Rust dependencies"
    },
    {
      "matchManagers": [
        "uv"
      ],
      "matchFiles": [
        "**/pyproject.toml",
        "**/uv.lock"
      ],
      "groupName": "Python dependencies"
    },
    {
      "matchPackagePrefixes": [
        "arrow",
        "parquet"
      ],
      "groupName": "Arrow/Parquet"
    },
    {
      "matchPackagePrefixes": [
        "datafusion"
      ],
      "groupName": "DataFusion"
    },
    {
      "matchPackagePrefixes": [
        "flatbuffers",
        "flexbuffers"
      ],
      "groupName": "flatbuffers"
    },
    {
      "matchPackagePrefixes": [
        "futures"
      ],
      "groupName": "futures"
    },
    {
      "matchPackagePrefixes": [
        "tonic"
      ],
      "groupName": "tonic"
    },
    {
      "matchPackageNames": [
        "**opentelemetry**"
      ],
      "groupName": "OpenTelemetry"
    },
    {
      "matchPackagePrefixes": [
        "vortex"
      ],
      "groupName": "vortex"
    },
    {
      "matchPackagePrefixes": [
        "iceberg"
      ],
      "groupName": "iceberg"
    },
        {
      "matchPackagePrefixes": [
        "pyo3"
      ],
      "groupName": "pyo3"
    }
  ]
}
