{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeMinor",
    ":automergePr",
    ":automergeRequireAllStatusChecks",
    ":combinePatchMinorReleases",
    ":dependencyDashboard",
    ":separateMultipleMajorReleases",
    "helpers:pinGitHubActionDigests",
    ":configMigration"
  ],
  "schedule": ["* 0-4 * * *"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-4 * * 1"]
  },
  "autoApprove": true,
  "automergeStrategy": "squash",
  "rebaseWhen": "conflicted",
  "cloneSubmodules": true,
  "platformAutomerge": true,
  "postUpdateOptions": [
    "pnpmDedupe"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "cargo"
      ],
      "groupName": "Rust dependencies",
      "branchPrefix": "renovate/cargo/"
    },
    {
      "matchManagers": [
        "uv"
      ],
      "matchFiles": [
        "**/pyproject.toml",
        "**/uv.lock"
      ],
      "groupName": "Python dependencies",
      "branchPrefix": "renovate/uv/"
    },
    {
      "matchPackageNames": [
        "arrow*",
        "parquet*"
      ],
      "groupName": "Arrow/Parquet"
    },
    {
      "matchPackageNames": [
        "datafusion*"
      ],
      "groupName": "DataFusion"
    },
    {
      "matchPackageNames": [
        "flatbuffers*",
        "flexbuffers*"
      ],
      "groupName": "flatbuffers"
    },
    {
      "matchPackageNames": [
        "futures*"
      ],
      "groupName": "futures"
    },
    {
      "matchPackageNames": [
        "tonic*"
      ],
      "groupName": "tonic"
    },
    {
      "matchPackageNames": [
        "**opentelemetry**"
      ],
      "groupName": "OpenTelemetry"
    },
    {
      "matchPackageNames": [
        "vortex*"
      ],
      "groupName": "vortex"
    },
    {
      "matchPackageNames": [
        "iceberg*"
      ],
      "groupName": "iceberg"
    },
        {
      "matchPackageNames": [
        "pyo3*"
      ],
      "groupName": "pyo3"
    }
  ]
}
